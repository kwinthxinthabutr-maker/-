-- 1. ระบบความปลอดภัยสูงสุด: Metatable Hooking (Anti-Cheat Bypass)[span_15](start_span)[span_15](end_span)
-- =====================================================================
local mt = getrawmetatable(game)
setreadonly(mt, false)
local oldNamecall = mt.__namecall

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    -- ดักจับและกรองแพ็กเกจก่อนส่งไปยังเซิร์ฟเวอร์หลัก (Security Inspection Point)[span_16](start_span)[span_16](end_span)
    if method == "FireServer" and self.ClassName == "RemoteEvent" then
        local remoteName = string.lower(self.Name)
        -- บล็อกคำสั่ง RemoteEvent ที่อาจทำให้ตายหรือถูกเตะจากเซิร์ฟเวอร์[span_17](start_span)[span_17](end_span)
        if string.find(remoteName, "die") or string.find(remoteName, "kill") or string.find(remoteName, "damage") or string.find(remoteName, "kick") then
            return nil
        end
    end
    return oldNamecall(self, ...)
end)
setreadonly(mt, true)

