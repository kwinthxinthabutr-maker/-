task.spawn(function()
    pcall(function()
        local stages = {
            {text = "Optimizing core process...", progress = 0.3, time = 0.3},
            {text = "Loading Cat Logo & Modules...", progress = 0.7, time = 0.3},
            {text = "Initialization complete.", progress = 1.0, time = 0.2},
        }

        for _, stage in ipairs(stages) do
            StatusLabel.Text = stage.text
            local tweenInfo = TweenInfo.new(stage.time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            TweenService:Create(BarFill, tweenInfo, {Size = UDim2.new(stage.progress, 0, 1, 0)}):Play()
            
            local targetPerc = math.floor(stage.progress * 100)
            local current = tonumber(PercLabel.Text:match("%d+")) or 0
            for i = current, targetPerc do
                PercLabel.Text = i .. "%"
                task.wait(stage.time / math.max(targetPerc - current, 1))
            end
            task.wait(0.1)
        end

        task.wait(0.3)
        for _, child in ipairs(MainFrame:GetDescendants()) do
            if child:IsA("TextLabel") or child:IsA("Frame") then
                child:Destroy()
            end
        end

        -- โลโก้หน้าแมว (Cat Logo)
        local LogoLabel = Instance.new("ImageLabel")
        LogoLabel.Name = "CatLogo"
        LogoLabel.Size = UDim2.new(0, 80, 0, 80)
        LogoLabel.Position = UDim2.new(0.5, -40, 0.5, -40)
        LogoLabel.BackgroundTransparency = 1
        LogoLabel.Image = "rbxassetid://7733965428"
        LogoLabel.ImageTransparency = 1
        LogoLabel.Parent = MainFrame

        local shrinkTween = TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 70, 0, 70),
            Position = UDim2.new(0.5, -35, 0.5, -35)
        })
        local logoTween = TweenService:Create(LogoLabel, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {ImageTransparency = 0})

        shrinkTween:Play()
        logoTween:Play()
        shrinkTween.Completed:Wait()
        task.wait(0.3)
        ScreenGui:Destroy()

        -- สร้าง Control Panel หลัก
        local ControlGui = Instance.new("ScreenGui")
        ControlGui.Name = "OptimizedESPUI"
        ControlGui.IgnoreGuiInset = true
        ControlGui.Parent = CoreGui

        local ControlFrame = Instance.new("Frame")
        ControlFrame.Size = UDim2.new(0, 240, 0, 210)
        ControlFrame.Position = UDim2.new(0.05, 0, 0.2, 0)
        ControlFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
        ControlFrame.BorderSizePixel = 0
        ControlFrame.Active = true
        ControlFrame.Draggable = true
        ControlFrame.Parent = ControlGui

        local CCorner = Instance.new("UICorner")
        CCorner.CornerRadius = UDim.new(0, 12)
        CCorner.Parent = ControlFrame

        local CStroke = Instance.new("UIStroke")
        CStroke.Color = Color3.fromRGB(60, 60, 90)
        CStroke.Thickness = 1.8
        CStroke.Parent = ControlFrame

        local HeaderBar = Instance.new("Frame")
        HeaderBar.Size = UDim2.new(1, 0, 0, 35)
        HeaderBar.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
        HeaderBar.BorderSizePixel = 0
        HeaderBar.Parent = ControlFrame

        local HeaderCorner = Instance.new("UICorner")
        HeaderCorner.CornerRadius = UDim.new(0, 12)
        HeaderCorner.Parent = HeaderBar

        local FixHeader = Instance.new("Frame")
        FixHeader.Size = UDim2.new(1, 0, 0, 10)
        FixHeader.Position = UDim2.new(0, 0, 1, -10)
        FixHeader.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
        FixHeader.BorderSizePixel = 0
        FixHeader.Parent = HeaderBar

        local CTitle = Instance.new("TextLabel")
        CTitle.Size = UDim2.new(1, -20, 1, 0)
        CTitle.Position = UDim2.new(0, 12, 0, 0)
        CTitle.BackgroundTransparency = 1
        CTitle.Font = Enum.Font.GothamBold
        CTitle.Text = "🐱 CAT PANEL & FRIED FOOD"
        CTitle.TextColor3 = Color3.fromRGB(255, 180, 0)
        CTitle.TextSize = 11
        CTitle.Parent = HeaderBar

        local ToggleBtn = Instance.new("TextButton")
        ToggleBtn.Size = UDim2.new(0, 216, 0, 36)
        ToggleBtn.Position = UDim2.new(0, 12, 0, 45)
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 255)
        ToggleBtn.Font = Enum.Font.GothamBold
        ToggleBtn.Text = "COMBAT SYSTEMS: ON"
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        ToggleBtn.TextSize = 11
        ToggleBtn.Parent = ControlFrame

        local BCorner = Instance.new("UICorner")
        BCorner.CornerRadius = UDim.new(0, 8)
        BCorner.Parent = ToggleBtn

        local SnackBtn = Instance.new("TextButton")
        SnackBtn.Size = UDim2.new(0, 216, 0, 36)
        SnackBtn.Position = UDim2.new(0, 12, 0, 88)
        SnackBtn.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
        SnackBtn.Font = Enum.Font.GothamBold
        SnackBtn.Text = "🍟 Spawn Fried Chicken"
        SnackBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        SnackBtn.TextSize = 11
        SnackBtn.Parent = ControlFrame

        local SnackCorner = Instance.new("UICorner")
        SnackCorner.CornerRadius = UDim.new(0, 8)
        SnackCorner.Parent = SnackBtn

        local StatusBox = Instance.new("Frame")
        StatusBox.Size = UDim2.new(0, 216, 0, 35)
        StatusBox.Position = UDim2.new(0, 12, 0, 132)
        StatusBox.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
        StatusBox.BorderSizePixel = 0
        StatusBox.Parent = ControlFrame

        local BoxCorner = Instance.new("UICorner")
        BoxCorner.CornerRadius = UDim.new(0, 8)
        BoxCorner.Parent = StatusBox

        local StatusTxt = Instance.new("TextLabel")
        StatusTxt.Size = UDim2.new(1, -10, 1, 0)
        StatusTxt.Position = UDim2.new(0, 10, 0, 0)
        StatusTxt.BackgroundTransparency = 1
        StatusTxt.Font = Enum.Font.GothamSemibold
        StatusTxt.Text = "Status: Cat Logo & Combat Active"
        StatusTxt.TextColor3 = Color3.fromRGB(0, 255, 150)
        StatusTxt.TextSize = 11
        StatusTxt.Parent = StatusBox

        local activeState = true
        ToggleBtn.MouseButton1Click:Connect(function()
            activeState = not activeState
            if activeState then
                ToggleBtn.Text = "COMBAT SYSTEMS: ON"
                ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 255)
                StatusTxt.TextColor3 = Color3.fromRGB(0, 255, 150)
                StatusTxt.Text = "Status: Combat Active"
            else
                ToggleBtn.Text = "COMBAT SYSTEMS: OFF"
                ToggleBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 90)
                StatusTxt.TextColor3 = Color3.fromRGB(200, 200, 200)
                StatusTxt.Text = "Status: Paused"
            end
        end)

        SnackBtn.MouseButton1Click:Connect(function()
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local part = Instance.new("Part")
                    part.Size = Vector3.new(2, 1, 2)
                    part.Position = char.HumanoidRootPart.Position + (char.HumanoidRootPart.CFrame.LookVector * 4) + Vector3.new(0, 1, 0)
                    part.BrickColor = BrickColor.new("Neon orange")
                    part.Material = Enum.Material.SmoothPlastic
                    part.Name = "FriedChicken_Snack"
                    part.Parent = Workspace
                    
                    local mesh = Instance.new("SpecialMesh")
                    mesh.MeshType = Enum.MeshType.Sphere
                    mesh.Scale = Vector3.new(1.2, 0.8, 1.2)
                    mesh.Parent = part
                    
                    StatusTxt.Text = "Status: Spawned Fried Chicken!"
                    task.delay(2, function()
                        if activeState then StatusTxt.Text = "Status: Combat Active" end
                    end)
                end
            end)
        end)

        local function applyHighlight(targetModel)
            if targetModel and not targetModel:FindFirstChild("SystemHighlight") then
                pcall(function()
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "SystemHighlight"
                    highlight.Adornee = targetModel
                    highlight.FillColor = Color3.fromRGB(255, 50, 50)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.Parent = targetModel
                end)
            end
        end

        local function getNearestTarget()
            local character = LocalPlayer.Character
            if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
            local rootPart = character.HumanoidRootPart
            
            local nearestTarget, shortestDistance = nil, math.huge
            for _, obj in ipairs(Workspace:GetChildren()) do
                if obj:IsA("Model") and obj ~= character and obj:FindFirstChild("HumanoidRootPart") then
                    local distance = (obj.HumanoidRootPart.Position - rootPart.Position).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        nearestTarget = obj
                    end
                end
            end
            return nearestTarget
        end

        task.spawn(function()
            while task.wait(0.5) do
                pcall(function()
                    if activeState then
                        local target = getNearestTarget()
                        if target then
                            applyHighlight(target)
                            local character = LocalPlayer.Character
                            if character and character:FindFirstChild("HumanoidRootPart") and target:FindFirstChild("HumanoidRootPart") then
                                local hrp = character.HumanoidRootPart
                                local targetHrp = target.HumanoidRootPart
                                local dist = (targetHrp.Position - hrp.Position).Magnitude
                                
                                hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(targetHrp.Position.X, hrp.Position.Y, targetHrp.Position.Z))
                                
                                if dist > 8 then
                                    local tweenInfo = TweenInfo.new(0.6, Enum.EasingStyle.Linear)
                                    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetHrp.Position + Vector3.new(0, 3, 3), targetHrp.Position)})
                                    tween:Play()
                                else
                                    local tool = character:FindFirstChildOfClass("Tool")
                                    if tool then
                                        tool:Activate()
                                    else
                                        pcall(function()
                                            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                                            task.wait(0.05)
                                            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                                        end)
                                    end
                                end
                            end
                        end
                    end
                end)
            end
        end)
    end)
end)
