-- 1. ระบบความปลอดภัยสูงสุด: METATABLE HOOKING (ANTI-CHEAT BYPASS)
-- =====================================================================
local rawMeta = getrawmetatable(game)
setreadonly(rawMeta, false)
local originalNamecall = rawMeta.__namecall

rawMeta.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if method == "FireServer" and self.ClassName == "RemoteEvent" then
        local remoteIdentifier = string.lower(self.Name)
        -- ดักจับและสกัดกั้นสัญญาณเสี่ยงที่ส่งไปเตะ แบน หรือสร้างความเสียหาย
        if string.find(remoteIdentifier, "die") 
            or string.find(remoteIdentifier, "kill") 
            or string.find(remoteIdentifier, "damage") 
            or string.find(remoteIdentifier, "kick") 
            or string.find(remoteIdentifier, "ban") 
            or string.find(remoteIdentifier, "anticheat") 
            or string.find(remoteIdentifier, "detection") then
            return nil
        end
    end
    return originalNamecall(self, ...)
end)
setreadonly(rawMeta, true)

