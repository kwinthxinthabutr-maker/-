local function showUI()
    main.Visible = true
    main.Size = UDim2.new(0, 380, 0, 320)
    main.Position = UDim2.new(0.5, -190, 0.5, -160)

    TweenService:Create(main, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 430, 0, 370),
        Position = UDim2.new(0.5, -215, 0.5, -185)
    }):Play()
    openBtn.Visible = false
end

local function hideUI()
    local t = TweenService:Create(main, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 380, 0, 320),
        Position = UDim2.new(0.5, -190, 0.5, -160)
    })
    t:Play()
    t.Completed:Connect(function()
        main.Visible = false
        openBtn.Visible = true
    end)
end

local function closeUI()
    Config.LockOnEnabled = false
    Config.Spin360Enabled = false
    main.Visible = false
    openBtn.Visible = false
end

