-- 5. สถาปัตยกรรมระบบเส้นโยง (TRACERS FROM PLAYER)
-- =====================================================================
local function RemoveTracerForPlayer(player)
    if TracerRegistry[player] then
        local data = TracerRegistry[player]
        if data.Beam then data.Beam:Destroy() end
        if data.TargetAttachment then data.TargetAttachment:Destroy() end
        TracerRegistry[player] = nil
    end
end

local function AttachTracer(targetPlayer)
    if targetPlayer == LocalPlayer then return end

    local function Apply(targetChar)
        if not targetChar then return end
        local myChar = LocalPlayer.Character
        if not myChar then return end

        local myRoot = myChar:WaitForChild("HumanoidRootPart", 5)
        local targetRoot = targetChar:WaitForChild("HumanoidRootPart", 5)
        if not myRoot or not targetRoot then return end

        local myAttachment = myRoot:FindFirstChild("PlayerOriginAttachment")
        if not myAttachment then
            myAttachment = Instance.new("Attachment")
            myAttachment.Name = "PlayerOriginAttachment"
            myAttachment.Parent = myRoot
        end

        RemoveTracerForPlayer(targetPlayer)

        local targetAttachment = Instance.new("Attachment")
        targetAttachment.Name = "EnemyTracerAttachment"
        targetAttachment.Parent = targetRoot

        local beam = Instance.new("Beam")
        beam.Name = "NeonTracerBeam"
        beam.Attachment0 = myAttachment
        beam.Attachment1 = targetAttachment
        beam.Color = ColorSequence.new(Color3.fromRGB(57, 255, 20))
        beam.Width0 = 0.15
        beam.Width1 = 0.15
        beam.Transparency = NumberSequence.new(0.2)
        beam.FaceCamera = true
        beam.Segments = 1
        beam.Parent = targetRoot

        TracerRegistry[targetPlayer] = {
            Beam = beam,
            TargetAttachment = targetAttachment
        }
    end

    if targetPlayer.Character then
        Apply(targetPlayer.Character)
    end

    targetPlayer.CharacterAdded:Connect(function(newChar)
        task.wait(0.5)
        if Config.TracersEnabled then
            Apply(newChar)
        end
    end)
end

local function ClearAllTracers()
    for player, data in pairs(TracerRegistry) do
        if data.Beam then data.Beam:Destroy() end
        if data.TargetAttachment then data.TargetAttachment:Destroy() end
    end
    table.clear(TracerRegistry)
end

