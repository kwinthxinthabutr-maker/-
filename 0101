createToggleButton("ล็อกเป้า (เช็คกำแพง + นิ่งเกิน 1 วิ)", "🎯", 48, false, function(active)
    Config.LockOnEnabled = active
    if active then
        SystemConnections.LockLoop = RunService.RenderStepped:Connect(function()
            pcall(function()
                if not Config.LockOnEnabled then return end
                local targetPart = AcquireOptimalTarget()
                if targetPart then
                    -- สุ่มค่า Micro-Offset ป้องกันการตรวจจับ Heuristic Aimbot
                    local microOffset = Vector3.new(
                        math.random(-2, 2) / 100,
                        math.random(-2, 2) / 100,
                        math.random(-2, 2) / 100
                    )
                    local targetPos = targetPart.Position + microOffset
                    local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, targetPos)

                    -- เลี้ยวกล้องแบบรวดเร็วแต่สมูท (Smoothness 0.38)
                    Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, Config.Smoothness)
                end
            end)
        end)
    else
        if SystemConnections.LockLoop then
            SystemConnections.LockLoop:Disconnect()
            SystemConnections.LockLoop = nil
        end
    end
end)

