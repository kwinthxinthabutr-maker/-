-- ฟังก์ชันตรวจสอบสิ่งกีดขวาง (Raycast Wall Check)
local function IsVisibleWithoutWall(targetPart, targetCharacter)
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("Head") then return false end

    local originPos = Camera.CFrame.Position
    local targetPos = targetPart.Position
    local direction = targetPos - originPos

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {myChar, targetCharacter, Camera}
    rayParams.IgnoreWater = true

    local rayResult = Workspace:Raycast(originPos, direction, rayParams)
    return rayResult == nil
end

-- เธรดตรวจจับความนิ่งของผู้เล่นทุกคนทุก 0.2 วินาที
task.spawn(function()
    while true do
        task.wait(0.2)
        local now = tick()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local currentPos = player.Character.HumanoidRootPart.Position
                local record = PlayerPositionHistory[player]

                if not record then
                    PlayerPositionHistory[player] = {
                        LastPos = currentPos,
                        StillStartTime = now,
                        IsStill = false
                    }
                else
                    local movedDistance = (currentPos - record.LastPos).Magnitude
                    if movedDistance > 0.3 then
                        record.LastPos = currentPos
                        record.StillStartTime = now
                        record.IsStill = false
                    else
                        if now - record.StillStartTime >= 1.0 then
                            record.IsStill = true
                        end
                    end
                end
            else
                PlayerPositionHistory[player] = nil
            end
        end
    end
end)

-- ฟังก์ชันคัดกรองเป้าหมาย: ศัตรูยืนนิ่งเกิน 1 วิ (Priority 1) > ศัตรูใกล้สุด (Priority 2) และไม่อยู่หลังกำแพง
local function AcquireOptimalTarget()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end

    local myPos = myChar.HumanoidRootPart.Position
    local bestStillTarget = nil
    local minStillDist = math.huge

    local bestNormalTarget = nil
    local minNormalDist = math.huge

    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= LocalPlayer and otherPlayer.Character then
            local char = otherPlayer.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            local targetPart = char:FindFirstChild(Config.LockMode)

            if hum and hum.Health > 0 and targetPart then
                local dist = (targetPart.Position - myPos).Magnitude
                if dist <= Config.MaxDistance then
                    if IsVisibleWithoutWall(targetPart, char) then
                        local record = PlayerPositionHistory[otherPlayer]
                        local isStationary = record and record.IsStill

                        if isStationary then
                            if dist < minStillDist then
                                minStillDist = dist
                                bestStillTarget = targetPart
                            end
                        else
                            if dist < minNormalDist then
                                minNormalDist = dist
                                bestNormalTarget = targetPart
                            end
                        end
                    end
                end
            end
        end
    end

    return bestStillTarget or bestNormalTarget
end

