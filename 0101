-- [4] ระบบมองคนเป็นสีเขียวนีออน + ป้ายชื่อเลือดระยะทาง (Neon Green ESP)
createToggleButton("ESP เขียวนีออน + ป้ายข้อมูล (Always On Top)", "👁️", 196, false, function(active)
    Config.NeonGreenESP = active
    if active then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                ApplyNeonGreen(p.Character, p)
            end
        end

        SystemConnections.ESPAdded = Players.PlayerAdded:Connect(function(newPlayer)
            newPlayer.CharacterAdded:Connect(function(newChar)
                task.wait(0.5)
                if Config.NeonGreenESP then ApplyNeonGreen(newChar, newPlayer) end
            end)
        end)

        -- ลูปอัปเดตเลือดและระยะทางแบบเรียลไทม์
        SystemConnections.ESPUpdate = RunService.RenderStepped:Connect(function()
            if not Config.NeonGreenESP then return end
            local myChar = LocalPlayer.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

            for char, data in pairs(HighlightRegistry) do
                pcall(function()
                    if data.InfoLabel and data.Humanoid and data.RootPart and data.RootPart.Parent then
                        local dist = 0
                        if myRoot then
                            local studs = (data.RootPart.Position - myRoot.Position).Magnitude
                            dist = math.floor(studs * Config.ConversionFactor)
                        end
                        local hp = math.max(0, math.floor(data.Humanoid.Health))
                        local maxHp = math.floor(data.Humanoid.MaxHealth)
                        data.InfoLabel.Text = string.format("HP: %d/%d | %dm", hp, maxHp, dist)
                    end
                end)
            end
        end)
    else
        if SystemConnections.ESPAdded then SystemConnections.ESPAdded:Disconnect() end
        if SystemConnections.ESPUpdate then SystemConnections.ESPUpdate:Disconnect() end
        for char, data in pairs(HighlightRegistry) do
            if data.Highlight and data.Highlight.Parent then data.Highlight:Destroy() end
            if data.Tag and data.Tag.Parent then data.Tag:Destroy() end
        end
        table.clear(HighlightRegistry)
    end
end)

