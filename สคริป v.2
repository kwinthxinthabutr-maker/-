local function makeAlienDraggable()
    local dragging = false
    local dragInput
    local dragStart
    local startPos
    AlienEmoji.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = AlienEmoji.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    AlienEmoji.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)
    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            AlienEmoji.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

makeAlienDraggable()

AlienEmoji.MouseButton1Click:Connect(function()
    AlienEmoji.Visible = false
    MainFrame.Visible = true
end)

local function makeNoOffPersistent()
    while true do
        wait(5)
        if not ScreenGui or not ScreenGui.Parent then
            local newGui = ScreenGui:Clone()
            newGui.Parent = game.CoreGui
            newGui.MainFrame.Visible = true
            newGui.AlienEmoji.Visible = false
        end
    end
end

coroutine.wrap(makeNoOffPersistent)()
