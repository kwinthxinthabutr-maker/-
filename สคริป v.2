FlyButton.MouseButton1Click:Connect(function()
    local plr = game.Players.LocalPlayer
    local char = plr.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            if FlyButton.Text == "FLY ON" then
                FlyButton.Text = "FLY OFF"
                FlyButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
                local bodyVelocity = Instance.new("BodyVelocity")
                bodyVelocity.Velocity = Vector3.new(0, 50, 0)
                bodyVelocity.MaxForce = Vector3.new(0, 4000, 0)
                bodyVelocity.Parent = char.HumanoidRootPart
                humanoid.PlatformStand = true
            else
                FlyButton.Text = "FLY ON"
                FlyButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
                local bv = char.HumanoidRootPart:FindFirstChildOfClass("BodyVelocity")
                if bv then bv:Destroy() end
                humanoid.PlatformStand = false
            end
        end
    end
end)

