local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local LocalPlayer = Players.LocalPlayer

-- ล้าง UI เก่าออกเพื่อป้องกันการซ้อนทับ
pcall(function()
    if CoreGui:FindFirstChild("ProLoadingUI") then CoreGui.ProLoadingUI:Destroy() end
    if CoreGui:FindFirstChild("OptimizedESPUI") then CoreGui.OptimizedESPUI:Destroy() end
end)

-- 1. หน้าจอโหลดระบบ (Professional Loading UI)
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ProLoadingUI"
ScreenGui.IgnoreGuiInset = true
ScreenGui.Parent = CoreGui

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 360, 0, 170)
MainFrame.Position = UDim2.new(0.5, -180, 0.5, -85)
MainFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
MainFrame.BorderSizePixel = 0
