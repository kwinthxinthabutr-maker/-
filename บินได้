local function makeAlienDraggable()
    local dragging
    local dragInput
    local dragStart
    local startPos
    AlienImage.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = AlienImage.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    AlienImage.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)
    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            AlienImage.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

makeAlienDraggable()

local function makeNoOffPersistent()
    while true do
        wait(5)
        if NoOffButton.Text == "CANNOT CLOSE" then
            if not ScreenGui or not ScreenGui.Parent then
                local newGui = ScreenGui:Clone()
                newGui.Parent = game.CoreGui
                newGui.MainFrame.Visible = true
                newGui.AlienImage.Visible = false
            end
        end
    end
end

coroutine.wrap(makeNoOffPersistent)()
