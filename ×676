-- =====================================================================
local mt = getrawmetatable(game)
setreadonly(mt, false)
local oldNamecall = mt.__namecall

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if method == "FireServer" and self.ClassName == "RemoteEvent" then
        local remoteName = string.lower(self.Name)
        -- บล็อกคำสั่งที่ทำให้เสียการชนะ โดนเตะ ตาย หรือโดนแบน[span_11](start_span)[span_11](end_span)[span_12](start_span)[span_12](end_span)
        if string.find(remoteName, "die") or string.find(remoteName, "kill") or string.find(remoteName, "damage") or string.find(remoteName, "kick") then
            return nil
        end
    end
    return oldNamecall(self, ...)
end)
setreadonly(mt, true)

