            FlyBodyGyro.CFrame = root.CFrame
            FlyBodyGyro.Parent = root
            
            hum:ChangeState(Enum.HumanoidStateType.Running)
            
            Connections.Fly = RunService.RenderStepped:Connect(function()
                pcall(function()
                    if not Settings.FlyEnabled or not root or not FlyBodyVelocity then return end
                    
                    for _, p in ipairs(char:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanTouch = false p.CanCollide = false end
                    end
                    
                    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                    hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
                    
                    local moveDir = Vector3.new(0, 0, 0)
                    -- เชื่อมต่อปุ่มลากในมือถือ (Touch Thumbstick) และหันกล้อง[span_39](start_span)[span_39](end_span)
                    if hum.MoveDirection.Magnitude > 0 then
                        moveDir = moveDir + (Camera.CFrame.LookVector * hum.MoveDirection.Z * -1) + (Camera.CFrame.RightVector * hum.MoveDirection.X)
                    end
                    -- ใช้ปุ่มกระโดดของมือถือเพื่อบินขึ้น[span_40](start_span)[span_40](end_span)
                    if UserInputService:IsKeyDown(Enum.KeyCode.Space) or hum.Jump then
                        moveDir = moveDir + Vector3.new(0, 1, 0)
                    end
                    -- ใช้ W S A D สำหรับคีย์บอร์ดเสริม
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
                    
                    if moveDir.Magnitude > 0 then
                        FlyBodyVelocity.Velocity = moveDir.Unit * Settings.FlySpeed
                    else
                        FlyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
                    end
                    FlyBodyGyro.CFrame = Camera.CFrame
                end)
            end)
        end
    else
        if Connections.Fly then Connections.Fly:Disconnect() end
        if FlyBodyVelocity then FlyBodyVelocity:Destroy() end
        if FlyBodyGyro then FlyBodyGyro:Destroy() end
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanTouch = true if not Settings.NoclipEnabled then p.CanCollide = true end end
