local function smartTeleportToEgg(keyword)
   local found = false
   local targetKeyword = keyword:lower()

   for _, label in pairs(workspace:GetDescendants()) do
      if label:IsA("TextLabel") and label.Text:lower():find(targetKeyword) then
         local part = label:FindFirstAncestorWhichIsA("BasePart") or label:FindFirstAncestorWhichIsA("Model")
         if part then
            local targetPart = part:IsA("BasePart") and part or (part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart"))
            if targetPart and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
               player.Character.HumanoidRootPart.CFrame = targetPart.CFrame + Vector3.new(0, 4, 0)
               found = true
               break
            end
         end
      end
   end

   if not found then
      Rayfield:Notify({
         Title = "แจ้งเตือน",
         Content = "ไม่พบตำแหน่งไข่ " .. keyword,
         Duration = 3,
         Image = 4483362458,
      })
   end
end

