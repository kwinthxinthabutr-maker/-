-- หาตำแหน่งบ้าน / จุดเกิด
local function getHomePosition()
   local spawnLocation = workspace:FindFirstChild("SpawnLocation") or workspace:FindFirstChild("Spawns")
   if spawnLocation then
      if spawnLocation:IsA("BasePart") then
         return spawnLocation.Position + Vector3.new(0, 5, 0)
      else
         local firstSpawn = spawnLocation:FindFirstChildWhichIsA("BasePart")
         if firstSpawn then
            return firstSpawn.Position + Vector3.new(0, 5, 0)
         end
      end
   end
   return Vector3.new(0, 15, 0)
end

-- ฟังก์ชันบินทะลุสิ่งกีดขวางกลับบ้าน (เชือก/ฟิสิกส์ไม่หลุด)
local function flyBackHome()
   if isFlyingHome then return end
   isFlyingHome = true

   local char = player.Character
   if not char or not char:FindFirstChild("HumanoidRootPart") then 
      isFlyingHome = false
      return 
   end

   local hrp = char.HumanoidRootPart
   local targetPos = getHomePosition()

   -- ปิดแรงโน้มถ่วงและสร้างแรงขับดัน
   local bv = Instance.new("BodyVelocity")
   bv.Velocity = Vector3.zero
   bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
   bv.Parent = hrp

   -- ปิดการชนสิ่งกีดขวาง (Noclip)
   local noclipConn = RunService.Stepped:Connect(function()
      pcall(function()
         for _, p in pairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
               p.CanCollide = false
            end
         end
      end)
   end)

   -- วนลูปบินตรงกลับบ้าน
   task.spawn(function()
      while isFlyingHome do
         local currentPos = hrp.Position
         local direction = (targetPos - currentPos)
         local distance = direction.Magnitude

         -- ถึงบ้านแล้ว (ระยะต่ำกว่า 10 Studs)
         if distance < 10 then
            break
         end

         bv.Velocity = direction.Unit * flySpeed
         task.wait()
      end

      -- คืนค่าเดิม
      if bv then bv:Destroy() end
      if noclipConn then noclipConn:Disconnect() end
      if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
      
      pcall(function()
         for _, p in pairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
               p.CanCollide = true
            end
         end
      end)

      isFlyingHome = false
   end)
end

-- ==================== ตรวจจับการกด E แล้วสั่งบินทันที ====================

ProximityPromptService.PromptTriggered:Connect(function(prompt, triggerPlayer)
   if triggerPlayer == player and autoFlyOnE then
      -- รอให้ระบบของเกมผูกสัตว์/ไข่เข้าตัวเสร็จเล็กน้อย (0.1 วินาที) แล้วพุ่งกลับบ้านทันที
      task.wait(0.15)
      flyBackHome()
   end
end)

