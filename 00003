-- 1. ระบบความปลอดภัยสูงสุด: Metatable Hooking (Anti-Cheat Bypass)
-- =====================================================================
local mt = getrawmetatable(game)
setreadonly(mt, false)
local oldNamecall = mt.__namecall

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if method == "FireServer" and self.ClassName == "RemoteEvent" then
        local remoteName = string.lower(self.Name)
        -- บล็อกคำสั่งที่อาจทำให้ตายหรือเด้งหลุด
        if string.find(remoteName, "die") or string.find(remoteName, "kill") or string.find(remoteName, "damage") then
            return nil
        end
    end
    return oldNamecall(self, ...)
end)
setreadonly(mt, true)

