local function CreateLabel(parent, text, yPos)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -15, 0, 22)
    label.Position = UDim2.new(0, 5, 0, yPos)
    label.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
    label.Text = " " .. text
    label.TextColor3 = Color3.fromRGB(0, 170, 255)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = parent
    Instance.new("UICorner", label).CornerRadius = UDim.new(0, 4)
    return label
end

local function CreateToggle(parent, text, yPos, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -15, 0, 32)
    button.Position = UDim2.new(0, 5, 0, yPos)
    button.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
    button.Text = text .. ": ปิด"
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Font = Enum.Font.GothamSemibold
    button.TextSize = 12
    button.Parent = parent
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)

    local state = false
    button.MouseButton1Click:Connect(function()
        state = not state
        button.BackgroundColor3 = state and Color3.fromRGB(0, 160, 80) or Color3.fromRGB(40, 40, 48)
        button.Text = text .. (state and ": เปิด" or ": ปิด")
        callback(state)
    end)
    return button
end

local function CreateInput(parent, placeholder, yPos, callback)
    local input = Instance.new("TextBox")
    input.Size = UDim2.new(0.5, -12, 0, 28)
    input.Position = UDim2.new(0, 5, 0, yPos)
    input.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
    input.PlaceholderText = placeholder
    input.TextColor3 = Color3.fromRGB(255, 255, 255)
    input.Font = Enum.Font.Gotham
    input.TextSize = 11
    input.Parent = parent
    Instance.new("UICorner", input).CornerRadius = UDim.new(0, 4)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.5, -12, 0, 28)
    btn.Position = UDim2.new(0.5, 3, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
