CreateLabel(miscP, "⏳ หยุดเวลาโจโจ้ (The World)", 75)
CreateToggle(miscP, "THE WORLD! (หยุดเวลา)", 100, function(state)
    local char = LocalPlayer.Character
    if not char then return end
    if state then
        -- เอฟเฟกต์หน้าจอ
        local cc = Instance.new("ColorCorrectionEffect")
        cc.Name = "TimeStopCC"
        cc.Saturation = -1
        cc.Contrast = 0.5
        cc.TintColor = Color3.fromRGB(150, 150, 255)
        cc.Parent = Lighting
        
        -- หยุดเวลาผู้เล่นคนอื่น
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                for _, part in ipairs(p.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        timeStoppedParts[part] = part.Anchored
                        part.Anchored = true
                    end
                end
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum then
                    for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
                        track:AdjustSpeed(0)
                        table.insert(frozenTracks, track)
                    end
                end
            end
        end
    else
        -- ปลดล็อกเวลาและลบเอฟเฟกต์
        if Lighting:FindFirstChild("TimeStopCC") then Lighting.TimeStopCC:Destroy() end
        for part, originalAnchored in pairs(timeStoppedParts) do
            if part and part.Parent then part.Anchored = originalAnchored end
        end
        timeStoppedParts = {}
        for _, track in ipairs(frozenTracks) do
