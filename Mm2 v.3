-- ============================================================
--  เอฟเฟกต์ X-Ray (ไม่มีสีแดงเริ่มต้น)
-- ============================================================
local function applyXRayEffect()
    if not SYSTEM_ON or not XRAY_ON then
        return
    end
    
    local intensity = PEN_LEVEL / 100
    
    local cc = Lighting:FindFirstChild("XRayColorCorrection")
    if not cc then
        cc = Instance.new("ColorCorrectionEffect")
        cc.Name = "XRayColorCorrection"
        cc.Parent = Lighting
    end
    
    if CURRENT_MODE == "THERMAL" then
        Lighting.Ambient = Color3.new(0.3 * intensity, 0.05 * intensity, 0.05 * intensity)
        Lighting.OutdoorAmbient = Color3.new(0.4 * intensity, 0.1 * intensity, 0.05 * intensity)
        Lighting.Brightness = 0.7
        cc.TintColor = Color3.new(1, 0.3, 0.1)
        cc.Saturation = 0.3
    elseif CURRENT_MODE == "EDGE" then
        Lighting.Ambient = Color3.new(0.1, 0.1, 0.1)
        Lighting.OutdoorAmbient = Color3.new(0.1, 0.1, 0.1)
        Lighting.Brightness = 0.3
        cc.TintColor = Color3.new(0.5, 0.5, 0.5)
        cc.Saturation = -0.8
    elseif CURRENT_MODE == "GHOST" then
        Lighting.Ambient = Color3.new(0, 0.5 * intensity, 0)
        Lighting.OutdoorAmbient = Color3.new(0, 0.5 * intensity, 0)
        Lighting.Brightness = 0.4
        cc.TintColor = Color3.new(0, 1, 0.3)
        cc.Saturation = 0.8
    elseif CURRENT_MODE == "INFRARED" then
        Lighting.Ambient = Color3.new(0.3 * intensity, 0, 0.6 * intensity)
        Lighting.OutdoorAmbient = Color3.new(0.25 * intensity, 0, 0.5 * intensity)
        Lighting.Brightness = 0.5
        cc.TintColor = Color3.new(0.8, 0, 1)
        cc.Saturation = 0.6
    elseif CURRENT_MODE == "NIGHTVISION" then
        Lighting.Ambient = Color3.new(0, 0.8 * intensity, 0)
        Lighting.OutdoorAmbient = Color3.new(0, 0.8 * intensity, 0)
        Lighting.Brightness = 0.2
        cc.TintColor = Color3.new(0, 1, 0.2)
        cc.Saturation = 0.5
    end
    
    local bloom = Lighting:FindFirstChild("XRayBloom")
    if not bloom then
        bloom = Instance.new("BloomEffect")
        bloom.Name = "XRayBloom"
        bloom.Parent = Lighting
    end
    bloom.Intensity = 0.2 * intensity
    bloom.Size = 10
    bloom.Threshold = 0.5
end

