-- ฟังก์ชันลากหน้าต่าง (ใช้ Mouse events)
local function makeDraggable(frame, dragHandle)
    dragHandle.MouseButton1Down:Connect(function()
        if isMinimized then return end  -- ห้ามลากตอนย่อ
        dragStartPos = UserInputService:GetMouseLocation()
        frameStartPos = frame.Position
        local moveConnection, releaseConnection
        moveConnection = UserInputService.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement then
                local delta = UserInputService:GetMouseLocation() - dragStartPos
                frame.Position = UDim2.new(
                    frameStartPos.X.Scale, frameStartPos.X.Offset + delta.X,
                    frameStartPos.Y.Scale, frameStartPos.Y.Offset + delta.Y
                )
            end
        end)
        releaseConnection = UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                moveConnection:Disconnect()
                releaseConnection:Disconnect()
            end
        end)
    end)
end

-- ============================================================
--  ระบบกระโดดไม่จำกัด
-- ============================================================
local function setupInfiniteJump()
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if not INFINITE_JUMP_ON then return end
        if not SYSTEM_ON then return end
        if input.KeyCode == Enum.KeyCode.Space then
            if humanoid and humanoid.Parent then
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                humanoid.JumpPower = jumpPower
                task.wait(0.05)
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            end
        end
    end)
    
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.Q then
            jumpPower = math.min(100, jumpPower + 5)
            print("🔧 พลังกระโดด: " .. jumpPower)
        end
        if input.KeyCode == Enum.KeyCode.E then
            jumpPower = math.max(20, jumpPower - 5)
            print("🔧 พลังกระโดด: " .. jumpPower)
        end
    end)
end

local function toggleInfiniteJump()
    INFINITE_JUMP_ON = not INFINITE_JUMP_ON
    if INFINITE_JUMP_ON then
        humanoid.JumpPower = jumpPower
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        print("✅ กระโดดไม่จำกัด: ON")
    else
        humanoid.JumpPower = 50
        print("❌ กระโดดไม่จำกัด: OFF")
    end
end

-- ============================================================
--  สร้างปุ่มสไตล์
-- ============================================================
local function createStyledButton(parent, text, pos, size, bgColor, textColor)
    local btn = Instance.new("TextButton")
    btn.Size = size or UDim2.new(0, 160, 0, 36)
    btn.Position = pos or UDim2.new(0, 0, 0, 0)
    btn.BackgroundColor3 = bgColor or Color3.new(0.15, 0.15, 0.2)
    btn.TextColor3 = textColor or Color3.new(1, 1, 1)
    btn.Text = text or "ปุ่ม"
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamBold
    btn.BackgroundTransparency = 0
    btn.BorderSizePixel = 0
    btn.Parent = parent
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn
    
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = bgColor + Color3.new(0.05, 0.05, 0.05)}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = bgColor}):Play()
    end)
    
    return btn
end

