-- 10. ระบบประมวลผลแอนิเมชันหน้าจอโหลด (LOADING SEQUENCE ENGINE)
-- =====================================================================
task.spawn(function()
    local totalDuration = math.random(18, 25) / 10
    local startTime = tick()

    TweenService:Create(ProgressFill, TweenInfo.new(totalDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(1, 0, 1, 0)
    }):Play()

    while tick() - startTime < totalDuration do
        local elapsed = tick() - startTime
        local progress = math.clamp(elapsed / totalDuration, 0, 1)
        PercentDisplay.Text = string.format("%d%%", math.floor(progress * 100))
        task.wait()
    end

    PercentDisplay.Text = "100%"
    LoadLog.Text = "เปิดใช้งานระบบสำเร็จ"
    task.wait(0.3)

    local fadeTime = 0.35
    for _, item in ipairs(LoadBackground:GetDescendants()) do
        if item:IsA("TextLabel") then
            TweenService:Create(item, TweenInfo.new(fadeTime), {TextTransparency = 1}):Play()
            if item:FindFirstChildOfClass("UIStroke") then
                TweenService:Create(item:FindFirstChildOfClass("UIStroke"), TweenInfo.new(fadeTime), {Transparency = 1}):Play()
            end
        elseif item:IsA("Frame") then
            TweenService:Create(item, TweenInfo.new(fadeTime), {BackgroundTransparency = 1}):Play()
        end
    end
    TweenService:Create(LoadBackground, TweenInfo.new(fadeTime), {BackgroundTransparency = 1}):Play()

    task.wait(fadeTime)
    LoadGui:Destroy()

    MainGui.Enabled = true
    RestoreHub()
end)
