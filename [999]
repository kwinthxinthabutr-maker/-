local function MinimizeHub()
    local shrinkTween = TweenService:Create(MainWindow, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0)
    })
    shrinkTween:Play()
    shrinkTween.Completed:Connect(function()
        MainWindow.Visible = false
        FloatingButton.Visible = true
    end)
end

local function RestoreHub()
    FloatingButton.Visible = false
    MainWindow.Visible = true
    MainWindow.Size = UDim2.new(0, 240, 0, 200)
    MainWindow.Position = UDim2.new(0.5, -120, 0.5, -100)

    TweenService:Create(MainWindow, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 380, 0, 340),
        Position = UDim2.new(0.5, -190, 0.5, -170)
    }):Play()
end

