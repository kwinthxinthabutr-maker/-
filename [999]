-- 7. ฟังก์ชันสร้างปุ่มรันสคริปต์ (MULTITHREADING ACTION ENGINE)
-- =====================================================================
local function RegisterScriptButton(buttonName, executeCallback)
    local ActionBtn = Instance.new("TextButton")
    ActionBtn.Size = UDim2.new(1, 0, 0, 48)
    ActionBtn.BackgroundColor3 = Palette.ButtonBG
    ActionBtn.Text = buttonName
    ActionBtn.TextColor3 = Palette.TextPrimary
    ActionBtn.Font = Enum.Font.GothamBold
    ActionBtn.TextSize = 14
    ActionBtn.AutoButtonColor = false
    ActionBtn.Parent = ContentScroll
    Instance.new("UICorner", ActionBtn).CornerRadius = UDim.new(0, 8)

    local ButtonStroke = Instance.new("UIStroke")
    ButtonStroke.Color = Palette.NeonPurple
    ButtonStroke.Thickness = 1
    ButtonStroke.Transparency = 0.5
    ButtonStroke.Parent = ActionBtn

    ActionBtn.MouseEnter:Connect(function()
        TweenService:Create(ActionBtn, TweenInfo.new(0.15), {BackgroundColor3 = Palette.ButtonHover}):Play()
        TweenService:Create(ButtonStroke, TweenInfo.new(0.15), {Transparency = 0.1}):Play()
    end)
    ActionBtn.MouseLeave:Connect(function()
        TweenService:Create(ActionBtn, TweenInfo.new(0.15), {BackgroundColor3 = Palette.ButtonBG}):Play()
        TweenService:Create(ButtonStroke, TweenInfo.new(0.15), {Transparency = 0.5}):Play()
    end)

    ActionBtn.MouseButton1Click:Connect(function()
        TweenService:Create(ActionBtn, TweenInfo.new(0.1), {BackgroundColor3 = Palette.NeonPurple}):Play()
        task.wait(0.1)
        TweenService:Create(ActionBtn, TweenInfo.new(0.1), {BackgroundColor3 = Palette.ButtonHover}):Play()

        -- ป้องกัน Thread Blocking ด้วย task.spawn
        task.spawn(function()
            local success, err = pcall(executeCallback)
            if not success then
                warn("[Purple Neon Hub] Exec Error: " .. tostring(err))
            end
        end)
    end)
end

