-- 1. ระบบความปลอดภัยสูงสุด: METATABLE HOOKING (ครอบ pcall ป้องกันตัวรันค้าง)
-- =====================================================================
pcall(function()
    if typeof(hookmetamethod) == "function" then
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" and self.ClassName == "RemoteEvent" then
                local remoteName = string.lower(self.Name)
                if string.find(remoteName, "die") 
                    or string.find(remoteName, "kill") 
                    or string.find(remoteName, "damage") 
                    or string.find(remoteName, "kick") 
                    or string.find(remoteName, "ban") then
                    return nil
                end
            end
            return oldNamecall(self, ...)
        end))
    else
        local rawMeta = getrawmetatable(game)
        setreadonly(rawMeta, false)
        local originalNamecall = rawMeta.__namecall
        rawMeta.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" and self.ClassName == "RemoteEvent" then
                local remoteName = string.lower(self.Name)
                if string.find(remoteName, "die") 
                    or string.find(remoteName, "kill") 
                    or string.find(remoteName, "kick") 
                    or string.find(remoteName, "ban") then
                    return nil
                end
            end
            return originalNamecall(self, ...)
        end)
        setreadonly(rawMeta, true)
    end
end)

