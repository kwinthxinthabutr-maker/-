WallHackButton.MouseButton1Click:Connect(function()
    if not wallHackActive then
        wallHackActive = true
        WallHackButton.Text = "WALLHACK OFF"
        WallHackButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        for _, v in pairs(game.Workspace:GetDescendants()) do
            if v:IsA("BasePart") and v.Transparency < 1 then
                local connection
                connection = v:GetPropertyChangedSignal("Transparency"):Connect(function()
                    if v.Transparency < 1 then
                        v.Transparency = 0.5
                    end
                end)
                table.insert(wallHackConnections, connection)
                if v.Transparency < 1 then
                    v.Transparency = 0.5
                end
            end
        end
    else
        wallHackActive = false
        WallHackButton.Text = "WALLHACK ON"
        WallHackButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        for _, connection in pairs(wallHackConnections) do
            connection:Disconnect()
        end
        wallHackConnections = {}
        for _, v in pairs(game.Workspace:GetDescendants()) do
            if v:IsA("BasePart") and v.Transparency == 0.5 then
                v.Transparency = 0
            end
        end
    end
end)

