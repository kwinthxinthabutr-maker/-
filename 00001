    pcall(function()
        local placeId = game.PlaceId
        local currentJobId = game.JobId
        local sfUrl = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", placeId)
        local req = (syn and syn.request) or (http and http.request) or http_request or request
        
        if req then
            local response = req({Url = sfUrl, Method = "GET"})
            local data = HttpService:JSONDecode(response.Body)
            if data and data.data then
                for _, server in ipairs(data.data) do
                    if server.playing < server.maxPlayers and server.id ~= currentJobId and server.playing >= 1 then
                        TeleportService:TeleportToPlaceInstance(placeId, server.id, LocalPlayer)
                        break
                    end
                end
            end
        else
            TeleportService:Teleport(placeId, LocalPlayer)
        end
    end)
end)

