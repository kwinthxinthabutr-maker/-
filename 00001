-- [5] ระบบบินด้วยปุ่มในเกมโดยตรง (NATIVE MOBILE CONTROLS INTEGRATION)
CreateSectionLabel(moveP, "✈️ บินด้วยปุ่มในเกม (Native Mobile & Anti-Death)", 340)
CreateToggleButton(moveP, "เปิดระบบบิน (ใช้อนาล็อก+ปุ่มโดด)", 365, function(state)
    SurgeSettings.FlyEnabled = state
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")

    if state then
        if root and hum then
            FlyBodyVelocity = Instance.new("BodyVelocity")
            FlyBodyVelocity.Name = "SurgeFlyVelocity"
            FlyBodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            FlyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
            FlyBodyVelocity.Parent = root
            
            FlyBodyGyro = Instance.new("BodyGyro")
            FlyBodyGyro.Name = "SurgeFlyGyro"
            FlyBodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            FlyBodyGyro.CFrame = root.CFrame
            FlyBodyGyro.Parent = root
            
            hum:ChangeState(Enum.HumanoidStateType.Running)
            
            SurgeConnections.Fly = RunService.RenderStepped:Connect(function()
                pcall(function()
                    if not SurgeSettings.FlyEnabled or not root or not FlyBodyVelocity or not FlyBodyGyro then return end
                    
                    -- ตัดการทำงานของ Kill-Bricks ป้องกันการตายขณะบิน
                    for _, p in ipairs(char:GetDescendants()) do
                        if p:IsA("BasePart") then
                            p.CanTouch = false
                            p.CanCollide = false
                        end
                    end
                    
                    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                    hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
                    hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                    
                    local moveDir = Vector3.new(0, 0, 0)
                    
                    -- เชื่อมต่อกับ Dynamic Thumbstick ของมือถือโดยตรง
                    if hum.MoveDirection.Magnitude > 0 then
                        moveDir = moveDir + (Camera.CFrame.LookVector * hum.MoveDirection.Z * -1) + (Camera.CFrame.RightVector * hum.MoveDirection.X)
                    end
                    
                    -- บินไต่ระดับความสูงด้วยปุ่มกระโดดของ Roblox บนจอมือถือ
                    if UserInputService:IsKeyDown(Enum.KeyCode.Space) or hum.Jump then
                        moveDir = moveDir + Vector3.new(0, 1, 0)
                    end
                    
                    -- รองรับปุ่มคีย์บอร์ดเสริมสำหรับคอมพิวเตอร์
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.new(0, 1, 0) end
                    
                    if moveDir.Magnitude > 0 then
                        FlyBodyVelocity.Velocity = moveDir.Unit * SurgeSettings.FlySpeed
                    else
                        FlyBodyVelocity.Velocity = Vector3.new(0, 0, 0) -- ลอยตัวนิ่งสนิท
                    end
                    FlyBodyGyro.CFrame = Camera.CFrame
                end)
            end)
        end
    else
        if SurgeConnections.Fly then SurgeConnections.Fly:Disconnect() end
        if FlyBodyVelocity then FlyBodyVelocity:Destroy() end
        if FlyBodyGyro then FlyBodyGyro:Destroy() end
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanTouch = true
                    if not SurgeSettings.NoclipEnabled then p.CanCollide = true end
                end
            end
        end
    end
end)
