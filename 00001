-- ฟังก์ชันล็อกเป้า (Aimbot)
CreateSectionLabel(combatP, "🎯 ระบบล็อกเป้ามุมกล้อง (Aimbot)", 10)
local function GetClosestPlayerHead()
    local closestHead, minDistance = nil, math.huge
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local screenPos, onScreen = Camera:WorldToViewportPoint(player.Character.Head.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
                    if dist < minDistance then
                        minDistance = dist
                        closestHead = player.Character.Head
                    end
                end
            end
        end
    end
    return closestHead
end

CreateToggleButton(combatP, "ล็อกเป้าผู้เล่นใกล้สุด", 35, function(state)
    SurgeSettings.AimbotEnabled = state
    if state then
        SurgeConnections.Aimbot = RunService.RenderStepped:Connect(function()
            pcall(function()
                if SurgeSettings.AimbotEnabled then
                    local targetHead = GetClosestPlayerHead()
                    if targetHead then
                        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
                    end
                end
            end)
        end)
    else
        if SurgeConnections.Aimbot then SurgeConnections.Aimbot:Disconnect() end
    end
end)

