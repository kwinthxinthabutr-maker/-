-- 4.6 ระบบแก้ทางสกิล (Smoke Cleaner, Trap Highlighter, Hitbox, Auto-Evade)
local function RunTacticalMaintenance()
    local _, myHrp, myHum = GetSafeCharacter()

    -- ลบควันจากสกิล Smoke Knife และไฮไลท์กับดัก Molotov / Portal
    if State.Settings.AutoClearSmoke or State.Settings.HighlightArenaTraps then
        pcall(function()
            for _, obj in ipairs(Workspace:GetChildren()) do
                local lower = string.lower(obj.Name)
                if State.Settings.AutoClearSmoke and (string.find(lower, "smoke") or string.find(lower, "cloud") or string.find(lower, "fog")) then
                    for _, desc in ipairs(obj:GetDescendants()) do
                        if desc:IsA("ParticleEmitter") or desc:IsA("Smoke") then
                            desc.Enabled = false
                        elseif desc:IsA("BasePart") then
                            desc.Transparency = 1
                            desc.CanCollide = false
                        end
                    end
                end

                if State.Settings.HighlightArenaTraps and (string.find(lower, "molotov") or string.find(lower, "fire") or string.find(lower, "portal") or string.find(lower, "bomb")) then
                    if not obj:FindFirstChild("DMM_TrapHL") then
                        local hl = Instance.new("Highlight")
                        hl.Name = "DMM_TrapHL"
                        hl.FillColor = Color3.fromRGB(255, 120, 0)
                        hl.OutlineColor = Color3.fromRGB(255, 255, 0)
                        hl.Parent = obj
                        table.insert(State.CreatedInstances, hl)
                    end
                end
            end
        end)
    end

    -- ขยาย Hitbox ศัตรู และเช็คระยะหลบอัตโนมัติ
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local isTeammate = (LocalPlayer.Team ~= nil and player.Team == LocalPlayer.Team)
            local enemyHrp = player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
            local enemyHead = player.Character:FindFirstChild("Head") :: BasePart?
            local enemyHum = player.Character:FindFirstChildOfClass("Humanoid")

            if enemyHrp and enemyHum and enemyHum.Health > 0 and not isTeammate then
                if State.Settings.HitboxExpander then
                    local sz = math.clamp(State.Settings.HitboxSize, 2, 15)
                    local targetPart = (State.Settings.HitboxTargetPart == "Head" and enemyHead) or enemyHrp
                    if targetPart then
                        targetPart.Size = Vector3.new(sz, sz, sz)
                        targetPart.Transparency = State.Settings.HitboxTransparency
                        targetPart.Color = Color3.fromRGB(255, 70, 70)
                        targetPart.CanCollide = false
                    end
                else
                    enemyHrp.Size = Vector3.new(2, 2, 1)
                    enemyHrp.Transparency = 1
                end

                if myHrp and myHum then
                    local dist = (myHrp.Position - enemyHrp.Position).Magnitude
                    if dist <= State.Settings.EvadeTriggerDist then
                        if State.Settings.AutoEvadeJump and myHum.FloorMaterial ~= Enum.Material.Air then
                            myHum.Jump = true
                        end
                        if State.Settings.AutoEvadeBackstep then
                            local awayDir = (myHrp.Position - enemyHrp.Position).Unit
                            myHrp.CFrame = myHrp.CFrame + (awayDir * 4.5)
                        end
                    end
                end
            end
        end
    end
end

