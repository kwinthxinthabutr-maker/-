local function CreateTab(tabKey: string, tabTitle: string): ScrollingFrame
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -14, 0, 38)
    btn.BackgroundColor3 = Color3.fromRGB(34, 34, 48)
    btn.TextColor3 = Color3.fromRGB(215, 215, 225)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 12
    btn.Text = tabTitle
    btn.AutoButtonColor = false
    btn.Parent = Sidebar

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, -14, 1, -14)
    page.Position = UDim2.new(0, 7, 0, 7)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 4
    page.ScrollBarImageColor3 = Color3.fromRGB(255, 140, 40)
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible = false
    page.Parent = ContentArea

    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 7)
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Parent = page

    local pad = Instance.new("UIPadding")
    pad.PaddingBottom = UDim.new(0, 12)
    pad.PaddingRight = UDim.new(0, 6)
    pad.Parent = page

    btn.MouseButton1Click:Connect(function()
        for k, p in pairs(Tabs) do
            p.Visible = (k == tabKey)
        end
        for k, b in pairs(TabButtons) do
            if k == tabKey then
                b.BackgroundColor3 = Color3.fromRGB(255, 130, 35)
                b.TextColor3 = Color3.fromRGB(18, 18, 24)
            else
                b.BackgroundColor3 = Color3.fromRGB(34, 34, 48)
                b.TextColor3 = Color3.fromRGB(215, 215, 225)
            end
        end
    end)

    Tabs[tabKey] = page
    TabButtons[tabKey] = btn
    return page
end

