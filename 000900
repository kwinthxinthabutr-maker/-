local function ScanMurderDuelsMap()
    local waypoints: { [string]: CFrame } = {}
    for k, v in pairs(GameDatabase.StaticWaypoints) do
        waypoints[k] = v
    end

    local detectedArena = "Main Lobby (รอรอบดวล)"
    local folderNames: { string } = {}

    pcall(function()
        for _, child in ipairs(Workspace:GetChildren()) do
            if child:IsA("Folder") or child:IsA("Model") then
                table.insert(folderNames, child.Name .. " [" .. child.ClassName .. "]")
                local lowerName = string.lower(child.Name)

                if string.find(lowerName, "map") or string.find(lowerName, "arena") or string.find(lowerName, "level") then
                    local ok, pivotCF = pcall(function() return (child :: Model):GetPivot() end)
                    if ok and pivotCF then
                        detectedArena = child.Name
                        waypoints["Arena สด - ใจกลาง (" .. child.Name .. ")"] = pivotCF + Vector3.new(0, 8, 0)
                        waypoints["Arena สด - มุมสูง (" .. child.Name .. " High Ground)"] = pivotCF + Vector3.new(0, 36, 0)
                    end

                    for _, sub in ipairs(child:GetChildren()) do
                        local subLower = string.lower(sub.Name)
                        if sub:IsA("BasePart") then
                            if string.find(subLower, "spawn") or string.find(subLower, "team") or string.find(subLower, "vote") then
                                waypoints["จุดสำคัญ: " .. sub.Name] = sub.CFrame + Vector3.new(0, 5, 0)
                            end
                        elseif sub:IsA("Model") then
                            for _, keyword in ipairs(GameDatabase.KnownArenas) do
                                if string.find(subLower, string.lower(keyword)) then
                                    detectedArena = sub.Name
                                    local subOk, subCF = pcall(function() return sub:GetPivot() end)
                                    if subOk and subCF then
                                        waypoints["ด่านดวล: " .. sub.Name .. " (Center)"] = subCF + Vector3.new(0, 6, 0)
                                        waypoints["ด่านดวล: " .. sub.Name .. " (High Ground)"] = subCF + Vector3.new(0, 30, 0)
                                    end
                                end
                            end
                        end
                    end
                elseif string.find(lowerName, "lobby") or string.find(lowerName, "vote") or string.find(lowerName, "shop") then
                    local ok, cf = pcall(function()
                        if child:IsA("Model") then return child:GetPivot() end
                        local p = child:FindFirstChildWhichIsA("BasePart", true)
                        return p and p.CFrame or nil
                    end)
                    if ok and cf then
                        waypoints["Lobby สด - " .. child.Name] = cf + Vector3.new(0, 5, 0)
                    end
                end
            elseif child:IsA("SpawnLocation") then
                waypoints["จุดเกิด: " .. child.Name] = child.CFrame + Vector3.new(0, 5, 0)
            end
        end
    end)

    State.CachedMapInfo.CurrentArenaName = detectedArena
    State.CachedMapInfo.DetectedWaypoints = waypoints
    State.CachedMapInfo.DynamicFolders = folderNames
end

