-- ลูปที่ 1: อัปเดต ESP, พื้นกันตกน้ำ, ระบบแก้ทางสกิล และแบนเนอร์เตือนภัย (ทุก 0.15 วินาที)
task.spawn(function()
    while State.Running do
        pcall(function()
            UpdatePlayerESP()
            UpdateWaterHazardPlatform()
            RunTacticalMaintenance()
            ApplyCharacterAndEnvironmentSettings()

            -- อัปเดตแบนเนอร์เตือนภัยเมื่อศัตรูเข้าใกล้
            if State.Settings.ProximityThreatAlert then
                local nearestEnemy, _, dist = FindTargetEnemy(nil)
                if nearestEnemy and nearestEnemy.Character and dist <= State.Settings.ThreatAlertDistance then
                    local _, weaponName, _ = GetEquippedWeaponInfo(nearestEnemy.Character)
                    ThreatBanner.Visible = true
                    ThreatBanner.Text = string.format(
                        "⚠️ ระวัง! %s (%s) อยู่ห่างเพียง %d เมตร!",
                        nearestEnemy.DisplayName,
                        weaponName,
                        math.floor(dist)
                    )
                else
                    ThreatBanner.Visible = false
                end
            else
                ThreatBanner.Visible = false
            end
        end)
        task.wait(0.15)
    end
end)

-- ลูปที่ 2: อัปเดต Dashboard และเรดาร์อาวุธศัตรูในแท็บที่ 1 (ทุก 0.7 วินาที ไม่กิน FPS)
task.spawn(function()
    while State.Running do
        pcall(function()
            local _, hrp, hum = GetSafeCharacter()
            local posText = hrp and string.format("X: %.1f | Y: %.1f | Z: %.1f", hrp.Position.X, hrp.Position.Y, hrp.Position.Z) or "รอตัวละครเกิด..."
            local hpText = hum and string.format("%.0f / %.0f", hum.Health, hum.MaxHealth) or "0 / 0"
            local fps = math.floor(1 / math.max(RunService.RenderStepped:Wait(), 0.001))

            LiveGameBox.Text = string.format(
                "เกม: %s | ผู้พัฒนา: %s\nPlaceId: %d | ผู้เล่นในเซิร์ฟเวอร์: %d / %d คน | ด่าน: %s",
                GameDatabase.GameTitle,
                GameDatabase.Developer,
                game.PlaceId,
                #Players:GetPlayers(),
                Players.MaxPlayers,
                State.CachedMapInfo.CurrentArenaName
            )

            LiveStatsBox.Text = string.format(
                "พิกัด: %s | พลังชีวิต (HP): %s | FPS: %d\nสถานะ Orbit: %s | พื้นกันตกน้ำ: %s | Aimlock: %s",
                posText,
                hpText,
                fps,
                State.Settings.OrbitNearestEnemy and "เปิด" or "ปิด",
                State.Settings.WaterHazardFloor and "เปิด" or "ปิด",
                State.Settings.SoftCameraAimlock and "เปิด" or "ปิด"
            )

            -- สร้างสรุปเรดาร์ศัตรูสดสูงสุด 4 คนที่อยู่ใกล้ที่สุด
            local radarLines: { string } = {}
            if hrp then
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character then
                        local eHrp = plr.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
                        local eHum = plr.Character:FindFirstChildOfClass("Humanoid")
                        if eHrp and eHum and eHum.Health > 0 then
                            local _, wLabel, _ = GetEquippedWeaponInfo(plr.Character)
                            local d = math.floor((hrp.Position - eHrp.Position).Magnitude)
                            table.insert(radarLines, string.format("• %s [%d HP | %dm] ถือ: %s", plr.DisplayName, math.floor(eHum.Health), d, wLabel))
                        end
                    end
                    if #radarLines >= 4 then break end
                end
            end

            if #radarLines == 0 then
                LiveThreatRadarBox.Text = "เรดาร์: ยังไม่พบศัตรูในระยะสนามดวล หรือกำลังพักรอรอบใหม่ใน Lobby"
            else
                LiveThreatRadarBox.Text = table.concat(radarLines, "\n")
            end
        end)
        task.wait(0.7)
    end
end)
