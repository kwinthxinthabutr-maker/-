TrackConnection(RunService.RenderStepped:Connect(function(dt)
    if not State.Running then return end
    local _, myHrp, _ = GetSafeCharacter()
    if not myHrp then return end

    -- ระบบ Spinbot หมุนตัวหลบกระสุน
    if State.Settings.Spinbot then
        myHrp.CFrame = myHrp.CFrame * CFrame.Angles(0, math.rad(State.Settings.SpinbotSpeed), 0)
    end

    -- ระบบ Orbit วนรอบศัตรูที่ใกล้ที่สุด
    if State.Settings.OrbitNearestEnemy then
        local _, enemyHrp, dist = FindTargetEnemy(nil)
        if enemyHrp and dist < 85 then
            State.OrbitAngle = State.OrbitAngle + (dt * State.Settings.OrbitSpeed)
            local offsetX = math.cos(State.OrbitAngle) * State.Settings.OrbitRadius
            local offsetZ = math.sin(State.OrbitAngle) * State.Settings.OrbitRadius
            local targetPos = enemyHrp.Position + Vector3.new(offsetX, 1.5, offsetZ)
            myHrp.CFrame = CFrame.new(targetPos, enemyHrp.Position)
        end
    end

    -- ระบบ Soft Camera Aimlock ช่วยหันกล้องหาศัตรู
    if State.Settings.SoftCameraAimlock and Camera then
        local targetPlayer, enemyHrp, dist = FindTargetEnemy(nil)
        if targetPlayer and targetPlayer.Character and enemyHrp and dist < 150 then
            local aimPart = targetPlayer.Character:FindFirstChild(State.Settings.AimlockTargetPart) :: BasePart? or enemyHrp
            local goalCF = CFrame.new(Camera.CFrame.Position, aimPart.Position)
            Camera.CFrame = Camera.CFrame:Lerp(goalCF, math.clamp(State.Settings.AimlockSmoothness, 0.05, 1.0))
        end
    end
end))

