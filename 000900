-- ฟังก์ชันหา Parent ของ GUI ที่ปลอดภัยที่สุด
local function GetSafeGuiParent(): Instance
    local ok, res = pcall(function()
        if gethui then
            return gethui()
        elseif CoreGui and CoreGui:FindFirstChild("RobloxGui") then
            return CoreGui
        end
        return LocalPlayer:WaitForChild("PlayerGui", 5)
    end)
    if ok and res then
        return res
    end
    return LocalPlayer:WaitForChild("PlayerGui")
end

-- ฟังก์ชันตรวจสอบตัวละครของผู้เล่นอย่างปลอดภัย ป้องกัน Nil Error 100%
local function GetSafeCharacter(): (Model?, BasePart?, Humanoid?)
    local char = LocalPlayer.Character
    if not char or not char.Parent then
        return nil, nil, nil
    end
    local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then
        return nil, nil, nil
    end
    return char, hrp, hum
end

