CreateSectionHeader(Tab5, "วาร์ปไปหาผู้เล่นในเซิร์ฟเวอร์รายบุคคล (Player Teleporter)")
local PlayerTeleportContainer = Instance.new("Frame")
PlayerTeleportContainer.Size = UDim2.new(1, 0, 0, 0)
PlayerTeleportContainer.AutomaticSize = Enum.AutomaticSize.Y
PlayerTeleportContainer.BackgroundTransparency = 1
PlayerTeleportContainer.Parent = Tab5

local PlayerTeleportLayout = Instance.new("UIListLayout")
PlayerTeleportLayout.Padding = UDim.new(0, 5)
PlayerTeleportLayout.Parent = PlayerTeleportContainer

local function RefreshPlayerTeleportList()
    for _, child in ipairs(PlayerTeleportContainer:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            CreateButton(PlayerTeleportContainer, "👤 วาร์ปไปหา: " .. plr.DisplayName .. " (@" .. plr.Name .. ")", function()
                if plr.Character then
                    local tHrp = plr.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
                    if tHrp then
                        NavigateToCFrame(tHrp.CFrame * CFrame.new(0, 0, 4.5))
                    end
                end
            end)
        end
    end
end

CreateButton(Tab5, "🔄 อัปเดตรายชื่อผู้เล่นในเซิร์ฟเวอร์ปัจจุบัน", function()
    RefreshPlayerTeleportList()
end)

