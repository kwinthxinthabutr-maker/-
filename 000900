-- 4.1 ฟังก์ชันเดินทางด้วย Smooth Tween หรือ Instant Teleport
local function NavigateToCFrame(targetCF: CFrame)
    local _, hrp, hum = GetSafeCharacter()
    if not hrp or not hum then return end

    CancelActiveTween()

    pcall(function()
        LocalPlayer:RequestStreamAroundAsync(targetCF.Position, 3)
    end)

    if State.Settings.UseInstantTeleport then
        pcall(function()
            hrp.CFrame = targetCF
            hrp.AssemblyLinearVelocity = Vector3.zero
        end)
        return
    end

    local distance = (hrp.Position - targetCF.Position).Magnitude
    local speed = math.clamp(State.Settings.TweenSpeed, 25, 300)
    local duration = math.clamp(distance / speed, 0.12, 7.5)

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    local tween = TweenService:Create(hrp, tweenInfo, { CFrame = targetCF })
    State.ActiveTween = tween

    tween.Completed:Connect(function()
        if State.ActiveTween == tween then
            State.ActiveTween = nil
        end
    end)

    tween:Play()
end

-- 4.2 ฟังก์ชันตรวจสอบอาวุธในมือและประเภทยุทธวิธีของศัตรู
local function GetEquippedWeaponInfo(char: Model): (string, string, Color3)
    -- เช็ค Tool ที่ถืออยู่ใน Character ก่อน
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local lowerName = string.lower(tool.Name)
        if string.find(lowerName, "gun") or string.find(lowerName, "revolver") or string.find(lowerName, "pistol") then
            return "Revolver", "🔫 ปืน (" .. tool.Name .. ")", Color3.fromRGB(65, 175, 255)
        elseif string.find(lowerName, "knife") or string.find(lowerName, "blade") or string.find(lowerName, "dagger") or string.find(lowerName, "scythe") then
            return "Knife", "🔪 มีด (" .. tool.Name .. ")", Color3.fromRGB(255, 75, 75)
        else
            return "Ability", "⚡ สกิล (" .. tool.Name .. ")", Color3.fromRGB(255, 210, 65)
        end
    end
    return "None", "✋ มือเปล่า", Color3.fromRGB(190, 195, 205)
end

-- 4.3 ฟังก์ชันค้นหาศัตรูตามเงื่อนไข (ใกล้สุด / ถือมีด / ถือปืน)
local function FindTargetEnemy(filterWeaponType: string?): (Player?, BasePart?, number)
    local _, myHrp, _ = GetSafeCharacter()
    if not myHrp then return nil, nil, math.huge end

    local bestPlayer: Player? = nil
    local bestHrp: BasePart? = nil
    local shortestDist = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local isTeammate = (LocalPlayer.Team ~= nil and player.Team == LocalPlayer.Team)
            local eHrp = player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
            local eHum = player.Character:FindFirstChildOfClass("Humanoid")

            if eHrp and eHum and eHum.Health > 0 and not isTeammate then
                local weaponCategory, _, _ = GetEquippedWeaponInfo(player.Character)
                if not filterWeaponType or weaponCategory == filterWeaponType then
                    local dist = (myHrp.Position - eHrp.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        bestPlayer = player
                        bestHrp = eHrp
                    end
                end
            end
        end
    end

    return bestPlayer, bestHrp, shortestDist
end

-- 4.4 ระบบ Tactical ESP, X-Ray & Tracer Beams
local function UpdatePlayerESP()
    local _, myHrp, _ = GetSafeCharacter()

    if not State.Settings.ESPEnabled then
        for _, data in pairs(State.ESPObjects) do
            pcall(function()
                if data.Highlight then data.Highlight.Enabled = false end
                if data.Billboard then data.Billboard.Enabled = false end
                if data.Beam then data.Beam.Enabled = false end
            end)
        end
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
            local hum = char:FindFirstChildOfClass("Humanoid")

            if hrp and hum and hum.Health > 0 then
                local espEntry = State.ESPObjects[char]
                if not espEntry then
                    local hl = Instance.new("Highlight")
                    hl.Name = "DMM_ProHighlight"
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.FillTransparency = 0.55
                    hl.OutlineTransparency = 0.05
                    hl.Adornee = char
                    hl.Parent = char

                    local bb = Instance.new("BillboardGui")
                    bb.Name = "DMM_ProBillboard"
                    bb.Size = UDim2.new(0, 195, 0, 50)
                    bb.StudsOffset = Vector3.new(0, 3.4, 0)
                    bb.AlwaysOnTop = true
                    bb.Adornee = hrp
                    bb.Parent = char

                    local label = Instance.new("TextLabel")
                    label.Name = "InfoLabel"
                    label.Size = UDim2.new(1, 0, 1, 0)
                    label.BackgroundTransparency = 1
                    label.Font = Enum.Font.GothamBold
                    label.TextSize = 12
                    label.TextStrokeTransparency = 0.15
                    label.TextColor3 = Color3.fromRGB(255, 255, 255)
                    label.Parent = bb

                    local att1 = Instance.new("Attachment")
                    att1.Name = "DMM_TargetAtt"
                    att1.Parent = hrp

                    local beam = Instance.new("Beam")
                    beam.Name = "DMM_TracerBeam"
                    beam.FaceCamera = true
                    beam.Width0 = 0.12
                    beam.Width1 = 0.12
                    beam.Transparency = NumberSequence.new(0.25)
                    beam.Attachment1 = att1
                    beam.Enabled = false
                    beam.Parent = hrp

                    espEntry = {
                        Highlight = hl,
                        Billboard = bb,
                        Beam = beam,
                        Attachment0 = nil,
                        Attachment1 = att1,
                    }
                    State.ESPObjects[char] = espEntry
                    table.insert(State.CreatedInstances, hl)
                    table.insert(State.CreatedInstances, bb)
                    table.insert(State.CreatedInstances, att1)
                    table.insert(State.CreatedInstances, beam)
                end

                local _, weaponLabel, weaponColor = GetEquippedWeaponInfo(char)
                local dist = myHrp and math.floor((myHrp.Position - hrp.Position).Magnitude) or 0
                local hp = math.floor(hum.Health)
                local isTeammate = (LocalPlayer.Team ~= nil and player.Team == LocalPlayer.Team)
                local finalColor = isTeammate and Color3.fromRGB(75, 255, 130) or weaponColor

                if espEntry.Highlight then
                    espEntry.Highlight.Enabled = true
                    espEntry.Highlight.FillColor = finalColor
                    espEntry.Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                end

                if espEntry.Billboard then
                    espEntry.Billboard.Enabled = true
                    local lbl = espEntry.Billboard:FindFirstChild("InfoLabel") :: TextLabel?
                    if lbl then
                        lbl.TextColor3 = finalColor
                        if State.Settings.ShowWeaponInHand then
                            lbl.Text = string.format("%s [%d HP | %dm]\n%s", player.DisplayName, hp, dist, weaponLabel)
                        else
                            lbl.Text = string.format("%s [%d HP | %dm]", player.DisplayName, hp, dist)
                        end
                    end
                end

                if espEntry.Beam then
                    if State.Settings.TracerBeams and myHrp and not isTeammate then
                        local myAtt = myHrp:FindFirstChild("DMM_MyOriginAtt") :: Attachment?
                        if not myAtt then
                            myAtt = Instance.new("Attachment")
