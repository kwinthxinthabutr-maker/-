local function CreateInfoBox(parent: ScrollingFrame, initialText: string, height: number?): TextLabel
    local box = Instance.new("TextLabel")
    box.Size = UDim2.new(1, 0, 0, height or 56)
    box.BackgroundColor3 = Color3.fromRGB(30, 30, 44)
    box.TextColor3 = Color3.fromRGB(235, 235, 245)
    box.Font = Enum.Font.Gotham
    box.TextSize = 12
    box.TextXAlignment = Enum.TextXAlignment.Left
    box.TextYAlignment = Enum.TextYAlignment.Center
    box.TextWrapped = true
    box.Text = initialText
    box.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = box

    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, 10)
    pad.PaddingRight = UDim.new(0, 10)
